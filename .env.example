NODE_ENV=development
PORT=5000

# Include the database name, e.g. mongodb+srv://user:pass@cluster.mongodb.net/gd-pharmaceuticals
MONGO_URI=

JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
# Node on this Windows machine falls back to DNS 127.0.0.1, which breaks mongodb+srv:// lookups.
DNS_SERVERS=1.1.1.1,8.8.8.8

# Extra browser origins allowed by CORS (deployed website and staff portal)
FRONTEND_URL=
FRONTEND_WWW_URL=
ADMIN_URL=

# Image and PDF uploads — POST /api/upload answers 503 until all three are set
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sender address for all emails
EMAIL_USER=
# Brevo API key (HTTPS) — needed on hosts that block SMTP
BREVO_API_KEY=
# Gmail app password — SMTP fallback for local development when BREVO_API_KEY is empty
EMAIL_PASS=
