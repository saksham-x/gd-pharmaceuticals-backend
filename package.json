{
  "name": "gd-pharmaceuticals-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB API for the G.D. Pharmaceuticals website and staff portal",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
